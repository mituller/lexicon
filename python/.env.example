# Copy to python/.env and fill from the CDK stack outputs. All vars are prefixed LEXICON_.
LEXICON_AWS_REGION=us-east-1

# S3 Vectors (must match infra/bootstrap_s3vectors.py)
LEXICON_VECTOR_BUCKET=lexicon-vectors
LEXICON_VECTOR_INDEX=vocabulary
LEXICON_EMBEDDING_DIMENSIONS=1024

# Bedrock models
LEXICON_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
LEXICON_GENERATION_MODEL_ID=us.amazon.nova-lite-v1:0

# DynamoDB
LEXICON_DYNAMODB_TABLE=lexicon

# Cognito (leave blank for local dev -> treated as the "dev-user")
LEXICON_COGNITO_USER_POOL_ID=
LEXICON_COGNITO_CLIENT_ID=
LEXICON_COGNITO_DOMAIN=
LEXICON_COGNITO_CALLBACK_URL=http://127.0.0.1:4200/callback
